# Motion Editor configuration.
#
# Copy to `config.env` and edit for your machine. `config.env` is gitignored,
# so local paths/servers never get committed. run.sh and scripts/sync_and_run.sh
# source it automatically if present; any value already set in your shell
# environment wins over these defaults.

# SSH server (user@host or ~/.ssh/config alias) holding motions + robot assets.
SERVER=deka

# Local checkout directory of this repo.
MOTION_EDITOR_DIR="$HOME/Internship/bHumanKiller/motion-editor"

# Remote paths, relative to the remote home (~). Used by run.sh.
REMOTE_MOTIONS="bHumanKiller/booster_assets/motions/K1"
REMOTE_ROBOTS="bHumanKiller/booster_assets/robots"

# Remote motions dir used by scripts/sync_and_run.sh (relative to remote ~).
REMOTE_MOTIONS_DIR="booster_assets/motions/K1"

# Optional: GMR assets root, used by the Python XML fallback (main.py) when a
# robot's XML is not found under assets/robots/. Leave unset if not using GMR.
# GMR_ROOT="$HOME/GMR"

# Optional: override where main.py looks for bundled robot assets.
# MOTION_EDITOR_ASSETS_DIR="$MOTION_EDITOR_DIR/assets/robots"
